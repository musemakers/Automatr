# ---------------------------------------------------------------------------
# AUTOMATr server configuration
# Copy this file to .env and fill in real values. Nothing here is committed.
# ---------------------------------------------------------------------------

# --- Core ---
PORT=5050
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# --- Database ---
# MongoDB connection string (Atlas or self-hosted)
MONGODB_URI=mongodb://127.0.0.1:27017/automatr

# --- Auth ---
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated emails that get admin role automatically on registration.
# The very first account ever created is always made admin regardless of
# this list, so you always have a way into the admin panel.
ADMIN_EMAILS=

# Optional: used only by `npm run seed:admin` (server/src/scripts/seedAdmin.js)
# as a fallback if you don't pass --email/--password/--name flags directly.
# Not read anywhere else - safe to leave blank.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
SEED_ADMIN_COMPANY=
SEED_ADMIN_INDUSTRY=

# --- Multi-model AI providers ---
# Add whichever you have. The router automatically skips providers with no key.
# Priority order for "auto" mode is controlled by AI_TEXT_PRIORITY / AI_IMAGE_PRIORITY below.

OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

ANTHROPIC_API_KEY=
ANTHROPIC_TEXT_MODEL=claude-sonnet-4-5

GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.0-flash
GEMINI_IMAGE_MODEL=gemini-2.0-flash-exp

# Seedream (ByteDance), served via BytePlus ModelArk - image generation only,
# no text/vision support. Get a key from https://console.byteplus.com (Ark).
SEEDREAM_API_KEY=
SEEDREAM_IMAGE_MODEL=seedream-4-5-251128
SEEDREAM_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# --- Video generation providers ---
# Video (Google Gemini Omni; env prefix kept as VEO_) rides on GEMINI_API_KEY above - no separate key needed.
VEO_MODEL=gemini-omni-1.1-flash

# Kling - https://klingai.com (developer/API access), JWT-signed from an
# access key / secret key pair rather than a single bearer token.
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_MODEL=kling-v2

# Runway - https://runwayml.com (API access via dev.runwayml.com)
RUNWAY_API_KEY=
RUNWAY_MODEL=gen4_turbo

# Seedance (ByteDance video), same BytePlus ModelArk account as Seedream
# above - defaults to reusing SEEDREAM_API_KEY/SEEDREAM_BASE_URL if these
# are left blank, so only set them separately if this account's video
# access uses a different key than its image access.
SEEDANCE_API_KEY=
SEEDANCE_MODEL=seedance-1-0-pro-250528
# Used only for image-to-video jobs (animating an existing key visual) -
# Ark requires a distinct model id for this, not just the plain model
# above plus an image attached. See providers/seedance.js for why.
SEEDANCE_I2V_MODEL=doubao-seedance-1-0-lite-i2v-250428
SEEDANCE_BASE_URL=

# Comma-separated provider priority when a request asks for "auto"
AI_TEXT_PRIORITY=openai,anthropic,gemini
AI_IMAGE_PRIORITY=openai,gemini,seedream
AI_VIDEO_PRIORITY=veo,kling,runway,seedance

# How many design directions to generate in Step 02
DESIGN_VARIANT_COUNT=6

# --- Optional: live stock quotes for the industry ticker ---
# https://finnhub.io - free tier key. If omitted, curated sample data is used.
FINNHUB_API_KEY=

# --- File uploads ---
# Where uploads + every generated image/video are stored (only their /uploads/... URLs go in MongoDB).
# LOCAL DEV: leave this unset (defaults to ./uploads).
# RAILWAY: do NOT set this. Attach a Volume mounted at /data and the app automatically uses
# /data/uploads (Railway provides RAILWAY_VOLUME_MOUNT_PATH). If you must set it, point it
# INSIDE the volume, e.g. UPLOAD_DIR=/data/uploads - a relative value like "uploads" is NOT on the volume.
# UPLOAD_DIR=
MAX_UPLOAD_MB=25

# --- Multi-customer ---
# Name of the first customer that existing users/posts/assets are moved into on the first
# start after upgrading. Only used once, when no customer exists yet.
DEFAULT_CUSTOMER_NAME=Musemakers
# Throw an error (instead of logging one warning) when a database query runs with no customer
# context. Turn this on after testing: it guarantees customers can never see each other's data.
# TENANT_STRICT=true
# Public self-sign-up is OFF. Accounts are created by admins. To let people register themselves
# into ONE customer, set both (new accounts are always plain members):
# ALLOW_PUBLIC_REGISTRATION=true
# PUBLIC_REGISTRATION_CUSTOMER=<customer folder name, e.g. acme>
# Public address of this server. Used to build absolute file links in webhook deliveries.
# PUBLIC_BASE_URL=https://your-app.up.railway.app
# Webhook delivery only allows public https addresses. For local testing ONLY:
# ALLOW_INSECURE_WEBHOOKS=true

# --- Email (SMTP) ---
# Used for welcome emails with login details when an admin invites a new customer admin / user.
# Optional: leave blank and the "Send welcome email" option reports that email isn't configured.
# After editing, restart the server. Run "npm install" once so the nodemailer package is present.
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (normally port 465). false = STARTTLS on 587 / plain on 25.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender shown to recipients, e.g. AUTOMATr <no-reply@yourdomain.com>
SMTP_FROM=
# Public address of the app, used as the sign-in link in emails (falls back to PUBLIC_BASE_URL,
# then http://localhost:5173).
# APP_URL=https://your-app.up.railway.app
